From: 23rd <23rd@vivaldi.net>
Date: Sun, 6 Sep 2026 10:16:14 +0300
Subject: [PATCH] Fixed submenu item clicks with Qt 6.11 on Windows.

---
 ui/widgets/popup_menu.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ui/widgets/popup_menu.cpp b/ui/widgets/popup_menu.cpp
index 524bda7..07dd257 100644
--- a/ui/widgets/popup_menu.cpp
+++ b/ui/widgets/popup_menu.cpp
@@ -1155,7 +1155,9 @@ void PopupMenu::showPrepared(TriggeredSource source) {
 	}
 	Platform::ShowOverAll(this);
 	raise();
-	activateWindow();
+	if (!_parent) {
+		activateWindow();
+	}
 	if (Ui::ScreenReaderModeActive()) {
 		_menu->setShowSource(TriggeredSource::Keyboard);
 	} else {
